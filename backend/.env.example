# Copy to backend/.env (or the repo-root .env) and fill in. Never commit the real file.
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_Supabase_key_here

# Who may use admin routes (/add, DELETE /songs, /admin/*). Comma-separated.
# The account must exist in Supabase Auth with a confirmed email. Empty = nobody.
ADMIN_EMAILS=you@example.com

# Browser origins allowed to call the API and open the WebSocket. Comma-separated, no trailing slash.
# Add your LAN address if you test from a phone, e.g. http://192.168.1.20:8080
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

