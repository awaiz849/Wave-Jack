# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# ── Backend API ── (no trailing slash; ws:// URL is derived from this)
VITE_API_URL=http://localhost:8000

# ── Supabase ── Dashboard → Settings → API (use the public anon key, not service_role)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_key_here
